// Modello dati del negozio.
// Regola d'oro: i PREZZI si salvano SEMPRE in centesimi (Int), mai come float.
// 0.1 + 0.2 = 0.30000000000000004 → con i soldi non ce lo possiamo permettere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // in produzione: "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique // usato negli URL: /categorie/abbigliamento
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  imageUrl    String
  active      Boolean   @default(true) // "spegnere" un prodotto senza cancellarlo
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  createdAt   DateTime  @default(now())
}

// La VARIANTE è ciò che si compra davvero: "Maglietta Blu, taglia M".
// Ognuna ha il suo codice (SKU), prezzo e scorta di magazzino.
model Variant {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  sku        String  @unique // Stock Keeping Unit, es. "TSHIRT-BLU-M"
  name       String // es. "Blu / M"
  priceCents Int // 1990 = 19,90 €
  stock      Int     @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

// ─── Lezione 2: carrello ───────────────────────────────────────────────
// Il carrello vive nel database; il browser conserva solo il suo id in un cookie.
model Cart {
  // cuid() = stringa casuale tipo "clx3k9...". NON un numero progressivo:
  // con id 1, 2, 3... chiunque potrebbe cambiare il cookie e vedere il carrello altrui.
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt // utile per cancellare i carrelli abbandonati
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  // Nessun prezzo salvato qui: il carrello mostra sempre il prezzo ATTUALE.
  // (L'ordine invece lo "congelerà": Lezione 3.)

  @@unique([cartId, variantId]) // una riga per variante: se la riaggiungi, cresce la quantità
}

// ─── Lezione 3: ordini ─────────────────────────────────────────────────
// Un ordine è un DOCUMENTO STORICO: deve restare identico per sempre,
// anche se domani cambi prezzi, nomi o cancelli prodotti.
// Per questo COPIA ("snapshot") tutti i dati invece di collegarsi a essi.
model Order {
  id       Int    @id @default(autoincrement()) // numero d'ordine interno: #000001
  publicId String @unique @default(cuid()) // usato negli URL: non indovinabile
  // Stati: PENDING_PAYMENT → PAID → SHIPPED → DELIVERED  (oppure CANCELLED)
  // SQLite non ha gli enum: usiamo una stringa e i tipi TypeScript in lib/orders.ts
  status   String @default("PENDING_PAYMENT")

  // Dati del cliente copiati nell'ordine (checkout come ospite, senza account)
  email      String
  firstName  String
  lastName   String
  address    String
  postalCode String
  city       String
  province   String
  country    String  @default("IT")
  phone      String?

  // Totali congelati al momento dell'ordine, in centesimi
  subtotalCents Int
  shippingCents Int
  totalCents    Int
  vatCents      Int // IVA inclusa nel totale (serve per la fattura)

  termsAcceptedAt DateTime // prova legale che il cliente ha accettato le condizioni
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Collegamento "debole" alla variante: utile per le statistiche,
  // ma se la variante viene cancellata l'ordine resta valido (SetNull).
  variantId Int?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // SNAPSHOT: copia dei dati com'erano al momento dell'acquisto
  productName    String
  variantName    String
  sku            String
  unitPriceCents Int
  quantity       Int
}
